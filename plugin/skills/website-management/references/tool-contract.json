{
  "architecture": {
    "browser_executor": "loopback_nodriver_sidecar",
    "contract_version_signals": [
      "export_contracts",
      "initialize_server_info",
      "x_mcp_contract_version_header"
    ],
    "credential_injection": "server_side_only",
    "dynamic_plugins": false,
    "mcp_cache_control": "no_store",
    "runtime": "static_rust_workflows",
    "schema_change_client_action": "refresh_or_reconnect_then_start_new_session",
    "supported_clients": [
      "chatgpt_web",
      "codex_macos",
      "codex_linux_cli"
    ],
    "tool_partitioning": "permission_and_confirmation_boundary",
    "transport": "mcp_streamable_http",
    "writable_truth": "elasticsearch"
  },
  "authentication": {
    "elasticsearch_auth_or_connection_failure": {
      "code": "workflow_unavailable",
      "layer": "tool",
      "outcome": "unavailable"
    },
    "missing_action_scope": {
      "code": "oauth_scope_required",
      "layer": "tool",
      "outcome": "forbidden"
    },
    "missing_or_invalid_token": {
      "code": "invalid_token",
      "layer": "http",
      "status": 401
    }
  },
  "contract_version": 9,
  "idempotency": {
    "caller_reuse_after_receipt_retention": false,
    "mismatch": {
      "code": "request_id_reused",
      "outcome": "rejected"
    },
    "request_id_scope": "globally_unique_across_mutations",
    "retry_rule": "reuse_only_for_the_same_canonical_request"
  },
  "tool_outcomes": [
    "ok",
    "not_found",
    "conflict",
    "rejected",
    "invalid",
    "forbidden",
    "unavailable"
  ],
  "url_normalization": {
    "resource_url": {
      "function": "normalize_resource_url",
      "normalizes": [
        "scheme_case",
        "host_case",
        "idna_host",
        "host_trailing_dot",
        "empty_path"
      ],
      "preserves": [
        "non_default_port",
        "path_case",
        "query_case",
        "query_order"
      ],
      "removes": [
        "default_port",
        "fragment"
      ],
      "requires_absolute_http_url": true
    },
    "site_identity": {
      "function": "normalize_site_identity",
      "identity": "normalized_host",
      "ignored": [
        "scheme",
        "port",
        "path",
        "query",
        "fragment"
      ],
      "www_is_distinct_without_alias": true
    }
  },
