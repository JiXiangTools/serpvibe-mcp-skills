{
  "architecture": {
    "browser_executor": "loopback_nodriver_sidecar",
    "contract_version_signals": [
      "export_contracts",
      "initialize_server_info",
      "x_mcp_contract_version_header"
    ],
    "credential_injection": "server_side_only",
    "dynamic_plugins": false,
    "mcp_cache_control": "no_store",
    "runtime": "static_rust_workflows",
    "schema_change_client_action": "refresh_or_reconnect_then_start_new_session",
    "supported_clients": [
      "chatgpt_web",
      "codex_macos",
      "codex_linux_cli"
    ],
    "tool_partitioning": "permission_and_confirmation_boundary",
    "transport": "mcp_streamable_http",
    "writable_truth": "elasticsearch"
  },
  "authentication": {
    "elasticsearch_auth_or_connection_failure": {
      "code": "workflow_unavailable",
      "layer": "tool",
      "outcome": "unavailable"
    },
    "missing_action_scope": {
      "code": "oauth_scope_required",
      "layer": "tool",
      "outcome": "forbidden"
    },
    "missing_or_invalid_token": {
      "code": "invalid_token",
      "layer": "http",
      "status": 401
    }
  },
  "contract_version": 11,
  "idempotency": {
    "caller_reuse_after_receipt_retention": false,
    "mismatch": {
      "code": "request_id_reused",
      "outcome": "rejected"
    },
    "request_id_scope": "globally_unique_across_mutations",
    "retry_rule": "reuse_only_for_the_same_canonical_request"
  },
  "tool_outcomes": [
    "ok",
    "not_found",
    "conflict",
    "rejected",
    "invalid",
    "forbidden",
    "unavailable"
  ],
  "url_normalization": {
    "resource_url": {
      "function": "normalize_resource_url",
      "normalizes": [
        "scheme_case",
        "host_case",
        "idna_host",
        "host_trailing_dot",
        "empty_path"
      ],
      "preserves": [
        "non_default_port",
        "path_case",
        "query_case",
        "query_order"
      ],
      "removes": [
        "default_port",
        "fragment"
      ],
      "requires_absolute_http_url": true
    },
    "site_identity": {
      "function": "normalize_site_identity",
      "identity": "normalized_host",
      "ignored": [
        "scheme",
        "port",
        "path",
        "query",
        "fragment"
      ],
      "www_is_distinct_without_alias": true
    }
  },
  "workflow": {
    "batch_create": {
      "action": "create_records",
      "default_outcome": "completed",
      "idempotency": "per_item_request_id",
      "max_items": 500,
      "min_items": 1,
      "partial_results": true,
      "result_order": "input_order",
      "supported_outcomes": [
        "completed",
        "failed",
        "uncertain"
      ]
    },
    "column_keys": {
      "invalid_code": "invalid_column_key",
      "max_length": 64,
      "pattern": "^[a-z][a-z0-9_]{0,63}$",
      "response_path": "record.values.<column_key>",
      "sensitive_exact": [
        "password",
        "passwd",
        "token",
        "cookie",
        "secret",
        "private_key",
        "api_key",
        "authorization",
        "session",
        "session_id"
      ],
      "sensitive_suffixes": [
        "_password",
        "_token",
        "_secret",
        "_cookie"
      ],
      "storage_path": "record.values.<column_key>",
      "system_fields_share_namespace": false
    },
    "duplicate_check": {
      "accepts_scope": false,
      "optional_and_conditions": [
        "task_ref",
        "task_name"
      ],
      "required_conditions": [
        "url"
      ],
      "result": {
        "code": "duplicate_checked",
        "field": "exists",
        "outcome": "ok",
        "type": "boolean"
      },
      "tool_name": "task_check_duplicate"
    },
    "identity": "task_ref and record_ref; read duplicate identity is normalized resource URL with optional task conditions; write dedupe is task-defined",
    "read_scope": "task:read",
    "retry": {
      "action": "retry_record",
      "lease_semantics": "same_as_reserve_record",
      "lineage_field": "retry_of",
      "new_status": "reserved",
      "source_mutation": "none",
      "source_status": "failed"
    },
