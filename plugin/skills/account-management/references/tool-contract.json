{
  "architecture": {
    "browser_executor": "loopback_nodriver_sidecar",
    "contract_version_signals": [
      "export_contracts",
      "initialize_server_info",
      "x_mcp_contract_version_header"
    ],
    "credential_injection": "server_side_only",
    "dynamic_plugins": false,
    "mcp_cache_control": "no_store",
    "runtime": "static_rust_workflows",
    "schema_change_client_action": "refresh_or_reconnect_then_start_new_session",
    "supported_clients": [
      "chatgpt_web",
      "codex_macos",
      "codex_linux_cli"
    ],
    "tool_partitioning": "permission_and_confirmation_boundary",
    "transport": "mcp_streamable_http",
    "writable_truth": "elasticsearch"
  },
  "authentication": {
    "elasticsearch_auth_or_connection_failure": {
      "code": "workflow_unavailable",
      "layer": "tool",
      "outcome": "unavailable"
    },
    "missing_action_scope": {
      "code": "oauth_scope_required",
      "layer": "tool",
      "outcome": "forbidden"
    },
    "missing_or_invalid_token": {
      "code": "invalid_token",
      "layer": "http",
      "status": 401
    }
  },
  "contract_version": 10,
  "idempotency": {
    "caller_reuse_after_receipt_retention": false,
    "mismatch": {
      "code": "request_id_reused",
      "outcome": "rejected"
    },
    "request_id_scope": "globally_unique_across_mutations",
    "retry_rule": "reuse_only_for_the_same_canonical_request"
  },
  "tool_outcomes": [
    "ok",
    "not_found",
    "conflict",
    "rejected",
    "invalid",
    "forbidden",
    "unavailable"
  ],
  "url_normalization": {
    "resource_url": {
      "function": "normalize_resource_url",
      "normalizes": [
        "scheme_case",
        "host_case",
        "idna_host",
        "host_trailing_dot",
        "empty_path"
      ],
      "preserves": [
        "non_default_port",
        "path_case",
        "query_case",
        "query_order"
      ],
      "removes": [
        "default_port",
        "fragment"
      ],
      "requires_absolute_http_url": true
    },
    "site_identity": {
      "function": "normalize_site_identity",
      "identity": "normalized_host",
      "ignored": [
        "scheme",
        "port",
        "path",
        "query",
        "fragment"
      ],
      "www_is_distinct_without_alias": true
    }
  },
  "workflow": {
    "identity": "normalized_host + normalized_username",
    "read_scope": "account:read",
    "skill_name": "account-management",
    "tools": [
      {
        "actions": [
          "get",
          "list"
        ],
        "annotations": {
          "destructiveHint": false,
          "idempotentHint": true,
          "openWorldHint": false,
          "readOnlyHint": true
        },
        "input_schema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "oneOf": [
            {
              "additionalProperties": false,
              "properties": {
                "account_ref": {
                  "type": "string"
                },
                "action": {
                  "const": "get",
                  "type": "string"
                }
              },
              "required": [
                "action",
                "account_ref"
              ],
              "type": "object"
            },
            {
              "additionalProperties": false,
              "properties": {
                "action": {
                  "const": "list",
                  "type": "string"
                },
                "cursor": {
                  "default": null,
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "digital_human_id": {
                  "default": null,
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "limit": {
                  "default": 50,
                  "format": "uint32",
                  "minimum": 0,
                  "type": "integer"
                },
                "url": {
                  "description": "Website URL. Path, query, fragment, host case, trailing dot, and port do not affect identity.",
                  "type": "string"
                }
              },
              "required": [
                "action",
                "url"
              ],
              "type": "object"
            }
          ],
          "title": "AccountReadRequest",
          "type": "object"
        },
        "required_scopes": [
          "account:read"
        ],
        "tool_name": "account_read"
      },
      {
        "actions": [
          "create",
          "update",
          "delete"
        ],
        "annotations": {
          "destructiveHint": true,
          "idempotentHint": true,
          "openWorldHint": false,
          "readOnlyHint": false
        },
        "input_schema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "oneOf": [
            {
              "additionalProperties": false,
              "properties": {
                "action": {
                  "const": "create",
                  "type": "string"
                },
                "digital_human_id": {
                  "type": "string"
                },
                "password": {
                  "type": "string"
                },
                "request_id": {
                  "type": "string"
                },
                "url": {
                  "description": "Website URL. Identity uses the same normalized host as `website_read` and `website_write`.",
                  "type": "string"
                },
                "username": {
                  "type": "string"
                }
              },
              "required": [
                "action",
                "request_id",
                "digital_human_id",
                "url",
                "username",
                "password"
              ],
              "type": "object"
            },
            {
              "additionalProperties": false,
              "properties": {
                "account_ref": {
                  "type": "string"
                },
                "action": {
                  "const": "update",
                  "type": "string"
                },
                "digital_human_id": {
                  "default": null,
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "expected_revision": {
                  "format": "uint64",
                  "minimum": 0,
                  "type": "integer"
                },
                "password": {
                  "default": null,
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "request_id": {
                  "type": "string"
                }
              },
              "required": [
                "action",
                "request_id",
                "account_ref",
                "expected_revision"
              ],
              "type": "object"
            },
            {
              "additionalProperties": false,
              "properties": {
                "account_ref": {
                  "type": "string"
                },
                "action": {
                  "const": "delete",
                  "type": "string"
                },
                "expected_revision": {
                  "format": "uint64",
                  "minimum": 0,
                  "type": "integer"
                },
                "request_id": {
                  "type": "string"
                }
              },
              "required": [
                "action",
                "request_id",
                "account_ref",
                "expected_revision"
              ],
              "type": "object"
            }
          ],
          "title": "AccountWriteRequest",
          "type": "object"
        },
        "required_scopes": [
          "account:write"
        ],
        "tool_name": "account_write"
      },
      {
        "actions": [
          "start_registration",
          "start_login",
          "start_password_change",
          "resume",
          "observe",
          "navigate",
          "click",
          "fill",
          "select",
          "inject_credentials",
          "complete",
          "cancel"
        ],
        "annotations": {
          "destructiveHint": true,
          "idempotentHint": false,
          "openWorldHint": true,
          "readOnlyHint": false
        },
        "credential_visibility": "server_side_injection_only",
        "external_side_effects": true,
        "idempotency": {
          "browser_actions": "session_scoped_by_action_id",
          "external_exactly_once": false,
          "start_and_complete": "durable_by_request_id"
        },
        "input_schema": {
          "$defs": {
            "PasswordPolicy": {
              "additionalProperties": false,
              "properties": {
                "digits": {
                  "default": true,
                  "type": "boolean"
                },
                "length": {
                  "default": 24,
                  "format": "uint16",
                  "maximum": 65535,
                  "minimum": 0,
                  "type": "integer"
                },
                "lowercase": {
                  "default": true,
                  "type": "boolean"
                },
                "symbols": {
                  "default": true,
                  "type": "boolean"
                },
                "uppercase": {
                  "default": true,
                  "type": "boolean"
                }
              },
              "type": "object"
            }
          },
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "oneOf": [
            {
              "additionalProperties": false,
              "properties": {
                "action": {
                  "const": "start_registration",
                  "type": "string"
                },
                "digital_human_id": {
                  "type": "string"
                },
                "password_policy": {
                  "$ref": "#/$defs/PasswordPolicy"
                },
                "request_id": {
                  "type": "string"
                },
                "url": {
                  "description": "Exact registration page URL. Unlike account identity, path and query are preserved.",
                  "type": "string"
                },
                "username": {
                  "type": "string"
                }
              },
              "required": [
                "action",
                "request_id",
                "digital_human_id",
                "url",
                "username"
              ],
              "type": "object"
            },
            {
              "additionalProperties": false,
              "properties": {
                "account_ref": {
                  "type": "string"
                },
                "action": {
                  "const": "start_login",
                  "type": "string"
                },
                "request_id": {
                  "type": "string"
                },
                "url": {
                  "default": null,
                  "description": "Exact login page URL. Defaults to the stored website origin.",
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "required": [
                "action",
                "request_id",
                "account_ref"
              ],
              "type": "object"
            },
            {
              "additionalProperties": false,
              "properties": {
                "account_ref": {
                  "type": "string"
                },
                "action": {
                  "const": "start_password_change",
                  "type": "string"
                },
                "expected_revision": {
                  "format": "uint64",
                  "minimum": 0,
                  "type": "integer"
                },
                "password_policy": {
                  "$ref": "#/$defs/PasswordPolicy"
                },
                "request_id": {
                  "type": "string"
                },
                "url": {
                  "default": null,
                  "description": "Exact password settings page URL. Defaults to the stored website origin.",
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "required": [
                "action",
                "request_id",
                "account_ref",
                "expected_revision"
              ],
              "type": "object"
            },
            {
              "additionalProperties": false,
              "properties": {
                "action": {
                  "const": "resume",
                  "type": "string"
                },
                "operation_ref": {
                  "type": "string"
                }
              },
              "required": [
                "action",
                "operation_ref"
              ],
              "type": "object"
            },
            {
              "additionalProperties": false,
              "properties": {
                "action": {
                  "const": "observe",
                  "type": "string"
                },
                "operation_ref": {
                  "type": "string"
                }
              },
              "required": [
                "action",
                "operation_ref"
              ],
              "type": "object"
            },
            {
              "additionalProperties": false,
              "properties": {
                "action": {
                  "const": "navigate",
                  "type": "string"
                },
                "action_id": {
                  "description": "Unique within this browser session. Duplicate action IDs are replayed by the worker.",
                  "type": "string"
                },
                "operation_ref": {
                  "type": "string"
                },
                "url": {
                  "type": "string"
                }
              },
              "required": [
                "action",
                "operation_ref",
                "action_id",
                "url"
              ],
              "type": "object"
            },
            {
              "additionalProperties": false,
              "properties": {
                "action": {
                  "const": "click",
                  "type": "string"
                },
                "action_id": {
                  "description": "Unique within this browser session. Duplicate action IDs are replayed by the worker.",
                  "type": "string"
                },
                "element_ref": {
                  "type": "string"
                },
                "operation_ref": {
                  "type": "string"
                }
              },
              "required": [
                "action",
                "operation_ref",
                "action_id",
                "element_ref"
              ],
              "type": "object"
            },
            {
              "additionalProperties": false,
              "properties": {
                "action": {
                  "const": "fill",
                  "type": "string"
                },
                "action_id": {
                  "description": "Unique within this browser session. Duplicate action IDs are replayed by the worker.",
                  "type": "string"
                },
                "element_ref": {
                  "type": "string"
                },
                "operation_ref": {
                  "type": "string"
                },
                "text": {
                  "type": "string"
                }
              },
              "required": [
                "action",
                "operation_ref",
                "action_id",
                "element_ref",
                "text"
              ],
              "type": "object"
            },
            {
              "additionalProperties": false,
              "properties": {
                "action": {
                  "const": "select",
                  "type": "string"
                },
                "action_id": {
                  "description": "Unique within this browser session. Duplicate action IDs are replayed by the worker.",
                  "type": "string"
                },
                "element_ref": {
                  "type": "string"
                },
                "operation_ref": {
                  "type": "string"
                },
                "value": {
                  "type": "string"
                }
              },
              "required": [
                "action",
                "operation_ref",
                "action_id",
                "element_ref",
                "value"
              ],
              "type": "object"
            },
            {
              "additionalProperties": false,
              "properties": {
                "action": {
                  "const": "inject_credentials",
                  "type": "string"
                },
                "confirm_password_element_ref": {
                  "default": null,
                  "description": "Optional password-confirmation field.",
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "current_password_element_ref": {
                  "default": null,
                  "description": "Existing-password field for a password change.",
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "new_password_element_ref": {
                  "default": null,
                  "description": "New-password field for a password change.",
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "operation_ref": {
                  "type": "string"
                },
                "password_element_ref": {
                  "default": null,
                  "description": "Password field for registration or login.",
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "username_element_ref": {
                  "default": null,
                  "description": "Username/email field for registration or login.",
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "required": [
                "action",
                "operation_ref"
              ],
              "type": "object"
            },
            {
              "additionalProperties": false,
              "properties": {
                "action": {
                  "const": "complete",
                  "type": "string"
                },
                "expected_revision": {
                  "default": null,
                  "description": "Only use after a password-change reconciliation conflict.",
                  "format": "uint64",
                  "minimum": 0,
                  "type": [
                    "integer",
                    "null"
                  ]
                },
                "operation_ref": {
                  "type": "string"
                }
              },
              "required": [
                "action",
                "operation_ref"
              ],
              "type": "object"
            },
            {
              "additionalProperties": false,
              "properties": {
                "action": {
                  "const": "cancel",
                  "type": "string"
                },
                "operation_ref": {
                  "type": "string"
                }
              },
              "required": [
                "action",
                "operation_ref"
              ],
              "type": "object"
            }
          ],
          "title": "AccountBrowserRequest",
          "type": "object"
        },
        "required_scopes": [
          "account:read",
          "account:write"
        ],
        "tool_name": "account_browser",
        "url_semantics": "resource_url_preserved_with_same_normalized_host_navigation"
      }
    ],
    "workflow_id": "account_management",
    "write_scope": "account:write"
  }
}
