{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "search-stack-mcp": {
      "type": "streamable-http",
      "url": "https://mcp-serpvibe.ficory.com/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "cimd"
            },
            "resource": "https://mcp-serpvibe.ficory.com/mcp",
            "baseScopes": [
              "offline_access",
              "account:read",
              "account:write",
              "website:read",
              "website:write",
              "task:read",
              "task:write"
            ],
            "defaultScopes": [],
            "oidcEnabled": false
          }
        }
      }
    }
  }
}
